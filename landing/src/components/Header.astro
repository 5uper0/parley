---
interface Props {
  large?: boolean;
  padded?: boolean;
  lang?: "en" | "es" | "uk";
}
const { large = false, padded = true, lang = "en" } = Astro.props;
const t = {
  en: { how: "How it works", demo: "Demo", theme: "theme", aria: "Switch between light and dark theme" },
  es: { how: "Cómo funciona", demo: "Demo", theme: "tema", aria: "Cambiar entre tema claro y oscuro" },
  uk: { how: "Як це працює", demo: "Демо", theme: "тема", aria: "Перемкнути світлу й темну тему" },
}[lang];
---

<header
  class:list={["flex items-center justify-between gap-4", padded && "py-9"]}
>
  <a
    href="/"
    class:list={[
      "-my-2 inline-flex items-center py-2 font-display tracking-[-0.025em] text-ink",
      large ? "text-[27px]" : "text-[21px]",
    ]}
  >
    parley<span class="text-redline">.</span>
  </a>
  <nav class="flex items-center gap-1">
    <a
      href="/#how-it-works"
      class="hidden items-center px-3 py-3 text-[13px] text-muted transition-colors hover:text-ink sm:inline-flex"
    >
      {t.how}
    </a>
    <a
      href="/demo/"
      class="inline-flex items-center px-3 py-3 text-[13px] text-muted transition-colors hover:text-ink"
    >
      {t.demo}
    </a>
    <a
      href="https://github.com/5uper0/parley"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center px-3 py-3 text-[13px] text-muted transition-colors hover:text-ink"
    >
      GitHub
    </a>
    <button
      type="button"
      aria-label={t.aria}
      aria-pressed="false"
      onclick="var r=document.documentElement;r.dataset.theme=r.dataset.theme==='dark'?'light':'dark';this.setAttribute('aria-pressed',r.dataset.theme==='dark');try{localStorage.setItem('parley-theme',r.dataset.theme)}catch(e){}"
      class="ml-1 inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-1.5 rounded-full border border-hairline bg-surface px-3 text-[12.5px] text-muted transition-colors hover:border-indigo hover:text-ink sm:ml-2 sm:px-[15px]"
    >
      <span aria-hidden="true">&#9681;</span><span class="hidden sm:inline">{t.theme}</span>
    </button>
  </nav>
</header>
