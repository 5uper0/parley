---
import futuristLogo from "../assets/futurist-logo-mono.svg?raw";

type FooterLink = { href: string; label: string; lang?: string; ext?: boolean };
interface Props {
  lang?: "en" | "es" | "uk";
}
const { lang = "en" } = Astro.props;
const T = {
  en: { product: "Product", learn: "Learn", other: "Other languages", project: "Project", demo: "Demo", verify: "Verify a receipt", mcp: "MCP setup", fair: "Fair negotiation", red: "Red lines", group: "Group decisions", contact: "Contact / Discussions", email: "Email", press: "Press", privacy: "Privacy", tag: "Open source Python library.", nav: "Footer" },
  es: { product: "Producto", learn: "Guías", other: "Otros idiomas", project: "Proyecto", demo: "Demo", verify: "Verificar un recibo", mcp: "Configurar MCP", fair: "Negociación justa", red: "Líneas rojas", group: "Decisiones de grupo", contact: "Contacto / Discusiones", email: "Correo", press: "Prensa", privacy: "Privacidad", tag: "Biblioteca Python de código abierto.", nav: "Pie de página" },
  uk: { product: "Продукт", learn: "Посібники", other: "Інші мови", project: "Проєкт", demo: "Демо", verify: "Перевірити квитанцію", mcp: "Налаштування MCP", fair: "Чесні переговори", red: "Червоні лінії", group: "Групові рішення", contact: "Контакт / Обговорення", email: "Пошта", press: "Преса", privacy: "Конфіденційність", tag: "Python-бібліотека з відкритим кодом.", nav: "Підвал сторінки" },
}[lang];
// Destination pages are English; label language follows the page, the link says so.
const hl = lang === "en" ? undefined : "en";
const groups: { title: string; links: FooterLink[] }[] = [
  {
    title: T.product,
    links: [
      { href: "/demo/", label: T.demo },
      { href: "/verify-ai-agent-decision/", label: T.verify },
      { href: "/mcp-multi-party-decisions/", label: T.mcp },
      { href: "https://github.com/5uper0/parley", label: "GitHub", ext: true },
    ],
  },
  {
    title: T.learn,
    links: [
      { href: "/fair-multi-agent-negotiation/", label: T.fair },
      { href: "/llm-agent-red-lines/", label: T.red },
      { href: "/fair-group-decision-private-limits/", label: T.group },
    ],
  },
  {
    title: T.other,
    links: [
      { href: "/es/reparto-de-herencia-entre-hermanos/", label: "Herencia entre hermanos", lang: "es" },
      { href: "/es/unanimidad-vender-piso-heredado/", label: "¿Unanimidad para vender?", lang: "es" },
      { href: "/uk/zghoda-spadkoyemtsiv-prodazh-kvartyry/", label: "Спадщина в Іспанії", lang: "uk" },
    ],
  },
  {
    title: T.project,
    links: [
      { href: "https://github.com/5uper0/parley/discussions", label: T.contact, ext: true },
      { href: "mailto:hello@parleyprotocol.com", label: T.email },
      { href: "https://www.linkedin.com/company/parleyprotocol", label: "LinkedIn", ext: true },
      { href: "/press/", label: T.press },
      { href: "https://github.com/5uper0/parley/blob/main/LICENSE", label: "Apache-2.0", ext: true },
      { href: "/privacy/", label: T.privacy },
    ],
  },
];
---

<footer class="px-6 py-10 md:px-16 lg:px-24">
  <nav aria-label={T.nav} class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4">
    {
      groups.map((g) => (
        <div>
          <h2 class="pb-1 text-sm font-semibold text-muted">{g.title}</h2>
          <ul class="flex flex-col">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  lang={l.lang}
                  hreflang={l.href.startsWith("/") && !l.lang ? hl : undefined}
                  target={l.ext ? "_blank" : undefined}
                  rel={l.ext ? "noopener" : undefined}
                  class="inline-flex min-h-[44px] min-w-[44px] items-center text-[14px] text-muted transition-colors hover:text-ink"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
  <p class="mt-6 text-[13px] text-muted">{T.tag}</p>
</footer>

<div class="fs-credit">
  <a
    class="fs-credit__link"
    href="https://futurist.systems/?utm_source=parleyprotocol.com&utm_medium=footer&utm_campaign=site-by"
    title="Website by Futurist Systems"
    rel="noopener"
    set:html={futuristLogo}
  />
</div>

<style is:global>
  .fs-credit {
    --fs-credit-opacity: 0.75;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6em;
    padding: 12px 16px 24px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1;
    color: var(--color-muted);
  }
  /* .75 fails 4.5:1 on the light theme's #f6f7fb; .86 clears it (4.64:1). */
  :root[data-theme="light"] .fs-credit {
    --fs-credit-opacity: 0.86;
  }
  .fs-credit__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    opacity: var(--fs-credit-opacity);
    transition: opacity 0.2s;
  }
  .fs-credit__link:hover,
  .fs-credit__link:focus-visible {
    opacity: 1;
  }
  .fs-credit__link svg {
    display: block;
    height: 16px;
    width: auto;
  }
</style>
