---

<footer class="flex flex-col gap-1 px-6 py-6 sm:flex-row sm:items-center sm:justify-between md:px-16 lg:px-24">
  <div class="flex flex-wrap items-center gap-x-2">
    <a
      href="/demo/"
      class="px-3 py-3 text-[13px] text-muted transition-colors hover:text-ink"
    >
      Demo
    </a>
    {
      links.map((l) => (
        <a
          href={l.href}
          target={l.href.startsWith("mailto:") ? undefined : "_blank"}
          rel={l.href.startsWith("mailto:") ? undefined : "noopener"}
          class="flex items-center gap-1.5 px-3 py-3 text-[13px] text-muted transition-colors hover:text-ink"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-3.5 w-3.5 flex-none"
            fill={l.fill ? "currentColor" : "none"}
            stroke={l.fill ? undefined : "currentColor"}
            stroke-width={l.fill ? undefined : "2"}
          >
            <path d={l.icon} />
          </svg>
          {l.label}
        </a>
      ))
    }
    <a
      href="https://github.com/5uper0/parley/blob/main/LICENSE"
      target="_blank"
      rel="noopener"
      class="px-3 py-3 text-[13px] text-muted transition-colors hover:text-ink"
    >
      Apache-2.0
    </a>
    <a
      href="https://parleyprotocol.com/privacy"
      class="px-3 py-3 text-[13px] text-muted transition-colors hover:text-ink"
    >
      Privacy
    </a>
  </div>
  <p class="px-3 text-[13px] text-muted">
    Open source · self-hosted · zero-dependency Python core
  </p>
</footer>
