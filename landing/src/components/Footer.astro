---
import futuristLogo from "../assets/futurist-logo-mono.svg?raw";

type FooterLink = { href: string; label: string; lang?: string; ext?: boolean };
const groups: { title: string; links: FooterLink[] }[] = [
  {
    title: "Product",
    links: [
      { href: "/demo/", label: "Demo" },
      { href: "/verify-ai-agent-decision/", label: "Verify a receipt" },
      { href: "/mcp-multi-party-decisions/", label: "MCP setup" },
      { href: "https://github.com/5uper0/parley", label: "GitHub", ext: true },
    ],
  },
  {
    title: "Learn",
    links: [
      { href: "/fair-multi-agent-negotiation/", label: "Fair negotiation" },
      { href: "/llm-agent-red-lines/", label: "Red lines" },
      { href: "/fair-group-decision-private-limits/", label: "Group decisions" },
    ],
  },
  {
    title: "Other languages",
    links: [
      { href: "/es/reparto-de-herencia-entre-hermanos/", label: "Herencia entre hermanos", lang: "es" },
      { href: "/es/unanimidad-vender-piso-heredado/", label: "¿Unanimidad para vender?", lang: "es" },
      { href: "/uk/zghoda-spadkoyemtsiv-prodazh-kvartyry/", label: "Спадщина в Іспанії", lang: "uk" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "https://github.com/5uper0/parley/discussions", label: "Contact / Discussions", ext: true },
      { href: "mailto:hello@parleyprotocol.com", label: "Email" },
      { href: "https://www.linkedin.com/company/parleyprotocol", label: "LinkedIn", ext: true },
      { href: "/press/", label: "Press" },
      { href: "https://github.com/5uper0/parley/blob/main/LICENSE", label: "Apache-2.0", ext: true },
      { href: "/privacy/", label: "Privacy" },
    ],
  },
];
---

<footer class="px-6 py-10 md:px-16 lg:px-24">
  <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4">
    {
      groups.map((g) => (
        <div>
          <h2 class="pb-1 text-sm font-semibold text-muted">{g.title}</h2>
          <ul class="flex flex-col">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  lang={l.lang}
                  target={l.ext ? "_blank" : undefined}
                  rel={l.ext ? "noopener" : undefined}
                  class="inline-flex min-h-[44px] min-w-[44px] items-center text-[14px] text-muted transition-colors hover:text-ink"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
  <p class="mt-6 text-[13px] text-muted">Open source Python library.</p>
</footer>

<div class="fs-credit">
  <a
    class="fs-credit__link"
    href="https://futurist.systems/?utm_source=parleyprotocol.com&utm_medium=footer&utm_campaign=site-by"
    title="Website by Futurist Systems"
    rel="noopener"
    set:html={futuristLogo}
  />
</div>

<style is:global>
  .fs-credit {
    --fs-credit-opacity: 0.75;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6em;
    padding: 12px 16px 24px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1;
    color: var(--color-muted);
  }
  /* .75 fails 4.5:1 on the light theme's #f6f7fb; .86 clears it (4.64:1). */
  :root[data-theme="light"] .fs-credit {
    --fs-credit-opacity: 0.86;
  }
  .fs-credit__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    opacity: var(--fs-credit-opacity);
    transition: opacity 0.2s;
  }
  .fs-credit__link:hover,
  .fs-credit__link:focus-visible {
    opacity: 1;
  }
  .fs-credit__link svg {
    display: block;
    height: 16px;
    width: auto;
  }
</style>
