---
// Last section. Line and buttons: landing-v3-copy 3.6, verbatim; the heading is the plain one
// from the design-dept ruling (M1).
import { DEMO_URL, REPO_URL } from "../../data/film-copy";

const title = "Run the dinner yourself";
const line = "See the dinner run, then run it on your own machine.";
const primary = { text: "Try the demo", href: DEMO_URL };
const secondary = [
  { text: "Install from PyPI", href: "https://pypi.org/project/parley-consensus/" },
  { text: "Read it on GitHub", href: REPO_URL },
];
---

<section id="closing" class="py-12 md:py-20" aria-labelledby="closing-h">
  <div class="home-wrap">
    <h2 id="closing-h" class="font-display text-2xl leading-tight tracking-tight text-ink">{title}</h2>
    <p class="mt-3 max-w-[64ch] text-base leading-relaxed text-muted">{line}</p>
    <p class="mt-6 flex flex-col gap-x-8 gap-y-2 md:flex-row md:items-center">
      <a
        href={primary.href}
        class="inline-flex min-h-12 items-center justify-center rounded-lg bg-ink px-6 text-base font-semibold text-bg"
      >
        {primary.text}
      </a>
      {
        secondary.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-11 items-center justify-center text-base text-ink underline underline-offset-4"
          >
            {l.text}
          </a>
        ))
      }
    </p>
  </div>
</section>
