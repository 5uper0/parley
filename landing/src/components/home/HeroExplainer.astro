---
// The hero stage: the dinner sample drawn in three beats (tell, yes or no, check).
// Options, costs, every yes or no and the result line are read from receipt-dinner.ts, which
// scripts/gen-receipt.py writes from a real run; the build fails if the copy and the run disagree.
// The rule line's tie clause is printed only from the run's pick facts, never typed.
// The styled state is the final frame, so no JS, reduced motion and print all show the whole story.
// Sizes are steps from docs/brand/tokens.css (type, space, radius); colours are the global tokens.
import { explainer as x } from "../../data/home-hero";
import { receiptDinner } from "../../data/receipt-dinner";

const title = (s: string) => s[0].toUpperCase() + s.slice(1);
const owners = [...new Set(receiptDinner.verdicts.map((v) => v.owner))];
const result = receiptDinner.output[0];

const options = receiptDinner.options.map((o) => {
  const verdicts = owners.map((owner) => {
    const v = receiptDinner.verdicts.find((r) => r.option === o.venue && r.owner === owner);
    if (!v) throw new Error(`no verdict for ${owner} on ${o.venue} in receipt-dinner.ts`);
    return { owner, acceptable: v.acceptable };
  });
  const blockers = verdicts.filter((v) => !v.acceptable).map((v) => v.owner);
  const picked = result.includes(`'${o.venue}'`);
  return { ...o, name: title(o.venue), verdicts, blockers, picked };
});

const blocked = options.filter((o) => o.blockers.length);
const picked = options.filter((o) => o.picked);
if (blocked.length !== 1 || picked.length !== 1 || picked[0].blockers.length) {
  throw new Error("the hero stage draws one blocked option and one picked option; the run no longer has that shape");
}
const [stop] = blocked;
if (stop.blockers.length !== 1 || !x.stamp.includes(stop.blockers[0])) {
  throw new Error(`stamp "${x.stamp}" does not name who said no to ${stop.venue} in the run`);
}
if (!x.plain.includes(stop.name) || !x.plain.includes(String(stop.cost))) {
  throw new Error(`plain sentence does not match the blocked option in the run (${stop.name}, ${stop.cost})`);
}
const pick = receiptDinner.pick;
const other = options.find((o) => o.venue === pick.runnerUp);
if (!pick.leastHappyTie || !pick.pickedTotalHigher || pick.picked !== picked[0].venue || !other || other.picked || other.blockers.length) {
  throw new Error("the rule line says the picked option ties the other one for the least-happy owner and has the higher total; the run no longer says that");
}
const chipFrom = owners.indexOf(stop.blockers[0]) - options.indexOf(stop);
const tag = (o: (typeof options)[number]) =>
  o.blockers.length ? x.tags.blocked : o.picked ? x.tags.picked : x.tags.feasible;
---

<div class="stage" data-stage>
  <p class="sr-only">{x.stageAria}</p>

  <div class="beat" data-beat="1">
    <div class="head">
      <p class="step"><span class="num">{x.beat1.num}</span> {x.beat1.step}</p>
      <p class="line">{x.beat1.line}</p>
    </div>
    <ul class="cols">
      {
        owners.map((owner, i) => (
          <li class="envelope" data-envelope={owner.toLowerCase()} style={`--i:${i}`}>
            <span class="env">
              <svg viewBox="0 0 168 76" preserveAspectRatio="none" aria-hidden="true">
                <rect x="0.5" y="0.5" width="167" height="75" rx="6" vector-effect="non-scaling-stroke" />
                <path d="M0.5 0.5 84 30 167.5 0.5" vector-effect="non-scaling-stroke" />
              </svg>
              <span class="seal" aria-hidden="true" />
              <span class="env-name">{x.envelope(owner)}</span>
            </span>
            <span class="env-agent">{x.agent(owner)}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="beat" data-beat="2">
    <div class="head">
      <p class="step"><span class="num">{x.beat2.num}</span> {x.beat2.step}</p>
      <p class="line">{x.beat2.line}</p>
    </div>
    <ul class="cols options">
      {
        options.map((o, i) => (
          <li
            data-option={o.venue}
            data-blocked={o.blockers.length ? "" : undefined}
            data-picked={o.picked ? "" : undefined}
            style={`--i:${i}`}
          >
            <div class="card">
              <p class="opt-name">{o.name}</p>
              <p class="opt-cost">{x.cost(o.cost)}</p>
              {o.blockers.length > 0 && <p class="stamp">{x.stamp}</p>}
            </div>
            <p class="tag">{tag(o)}</p>
          </li>
        ))
      }
      <li class="chip" data-chip aria-hidden="true" style={`--at:${options.indexOf(stop)};--from:${chipFrom}`}>{x.no}</li>
    </ul>
    <p class="plain">{x.plain}</p>
    <p class="rule" data-rule>{x.rule} <span data-tie>{x.tie(picked[0].name, other.name)}</span></p>
    <p class="engine">{x.engine}</p>
  </div>

  <div class="beat" data-beat="3">
    <div class="head">
      <p class="step"><span class="num">{x.beat3.num}</span> {x.beat3.step}</p>
    </div>
    <div class="receipt" data-receipt-card>
      <p class="r-head row" style="--i:0">{x.receipt.header}</p>
      <table>
        <thead>
          <tr class="row" style="--i:1">
            <td></td>
            {owners.map((owner) => <th scope="col">{owner}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            options.map((o, i) => (
              <tr class="row" style={`--i:${i + 2}`}>
                <th scope="row">{o.name}</th>
                {o.verdicts.map((v) => <td class={v.acceptable ? undefined : "no"}>{v.acceptable ? x.yes : x.no}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="r-result row" style={`--i:${options.length + 2}`}>{result}</p>
      <p class="r-line row" style={`--i:${options.length + 3}`}>{x.receipt.line}</p>
    </div>
  </div>

  <button type="button" class="replay" data-replay hidden>{x.replay}</button>
</div>
<p class="sample" data-sample-label>{x.sampleLabel}</p>

<script is:inline>
  (function () {
    var stage = document.querySelector("[data-stage]");
    var btn = stage && stage.querySelector("[data-replay]");
    if (!btn || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    btn.hidden = false;
    btn.addEventListener("click", function () {
      stage.classList.add("rewind");
      void stage.offsetWidth;
      stage.classList.remove("rewind");
    });
  })();
</script>

<style>
  .stage {
    --gap: 0.5rem;
    --env-h: 2rem;
    --card-h: 3.75rem;
    /* Where the chip starts, measured from where it lands: up to Bob's envelope (--rise) and
       in from the card's edge to the envelope's (--nudge). */
    --rise: 3.5rem;
    --nudge: 0rem;
    position: relative;
    container-type: inline-size;
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--hairline);
    border-radius: 0.75rem;
    background: var(--surface);
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .cols {
    list-style: none;
  }
  .beat {
    display: grid;
    gap: 0.25rem;
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .step,
  .line,
  .env-agent,
  .opt-cost,
  .engine,
  .r-head,
  thead th {
    color: var(--muted);
  }
  .step {
    flex: none;
    line-height: 1.15;
  }
  .num {
    color: var(--ink);
    font-weight: 600;
  }
  .line,
  .env-agent {
    display: none;
  }
  .cols {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }

  /* Beat 1 */
  .envelope {
    display: grid;
    justify-items: start;
  }
  .env {
    position: relative;
    display: block;
    width: 100%;
    height: var(--env-h);
  }
  .env svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .env rect {
    fill: var(--bg);
    stroke: var(--hairline);
  }
  .env path {
    fill: none;
    stroke: var(--hairline);
  }
  .seal {
    position: absolute;
    /* On the flap's point, 30 of 76 down the envelope. */
    top: calc(100% * 30 / 76);
    left: 50%;
    width: 0.625rem;
    height: 0.625rem;
    margin: -0.3125rem 0 0 -0.3125rem;
    border-radius: 9999px;
    background: var(--masked);
  }
  .env-name {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    color: var(--ink);
    font-size: 0.75rem;
    line-height: 1.15;
    text-align: center;
  }

  /* Beat 2 */
  .card {
    position: relative;
    height: var(--card-h);
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--hairline);
    border-radius: 0.75rem;
    background: var(--bg);
  }
  .opt-name {
    color: var(--ink);
    font-weight: 560;
    line-height: 1.15;
  }
  .opt-cost {
    font-size: 0.75rem;
    line-height: 1.35;
  }
  /* Dimmed as ink, not muted: muted at 0.6 falls under 4.5:1 on --bg. */
  [data-blocked] .opt-name,
  [data-blocked] .opt-cost {
    color: var(--ink);
    opacity: 0.6;
  }
  .stamp {
    position: absolute;
    bottom: 0.25rem;
    left: 0.25rem;
    max-width: calc(100% - 0.5rem);
    padding: 0 0.25rem;
    border: 1.5px solid var(--redline);
    border-radius: 0.25rem;
    background: var(--bg);
    color: var(--redline-text);
    font-size: 0.75rem;
    line-height: 1.15;
    transform: rotate(-4deg);
  }
  [data-picked] .card::after {
    content: "";
    position: absolute;
    inset: -1px;
    border: 2px solid var(--ink);
    border-radius: inherit;
    pointer-events: none;
  }
  .tag {
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.15;
  }
  [data-blocked] .tag {
    color: var(--redline-text);
  }
  [data-picked] .tag {
    color: var(--ink);
  }
  .chip {
    --card-w: calc((100cqw - 2 * var(--gap)) / 3);
    --col: calc(var(--card-w) + var(--gap));
    --inset: 0.25rem;
    position: absolute;
    top: var(--inset);
    left: calc(var(--at) * var(--col) + min(var(--card-w), 12rem) - 1.75rem - var(--inset));
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.25rem;
    border: 1px solid var(--redline);
    border-radius: 0.25rem;
    background: var(--bg);
    color: var(--redline-text);
    font-size: 0.75rem;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
  }
  .plain {
    color: var(--ink);
  }
  .rule {
    color: var(--ink);
    font-size: 0.75rem;
    line-height: 1.15;
  }
  .rule span {
    color: var(--muted);
  }
  .engine {
    padding-left: 0.5rem;
    border-left: 1px solid var(--indigo);
    line-height: 1.15;
  }

  /* Beat 3 */
  .receipt {
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--hairline);
    border-radius: 0.75rem;
    background: var(--bg);
  }
  .r-head {
    line-height: 1.15;
  }
  table {
    border-collapse: collapse;
    line-height: 1.15;
  }
  th,
  td {
    width: 4rem;
    padding: 0;
    color: var(--ink);
    font-weight: 400;
    text-align: left;
  }
  tr > :first-child {
    width: 5rem;
  }
  td.no {
    color: var(--redline-text);
  }
  .r-result {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-ligatures: none;
    white-space: nowrap;
  }
  .r-line {
    color: var(--ink);
    font-size: 0.75rem;
  }

  .replay {
    display: none;
  }
  .sample {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  @media (min-width: 721px) {
    .stage {
      --gap: 1rem;
      --env-h: 4.75rem;
      --card-h: 7rem;
      --rise: 8.875rem;
      --nudge: -1.5rem;
      gap: 1rem;
      padding: 1.5rem;
      border-radius: 1rem;
    }
    .beat {
      gap: 0.5rem;
    }
    .line {
      display: block;
    }
    .envelope {
      gap: 0.25rem;
    }
    .env {
      width: 10.5rem;
      max-width: 100%;
    }
    .env-agent {
      display: block;
    }
    .env-name {
      bottom: 0.5rem;
      font-size: 0.875rem;
    }
    .card {
      max-width: 12rem;
      padding: 1rem;
    }
    .opt-name {
      font-size: 1.125rem;
      line-height: 1.35;
    }
    .opt-cost,
    .stamp,
    .tag,
    .chip,
    .rule,
    .r-result {
      font-size: 0.875rem;
    }
    .stamp {
      bottom: 0.75rem;
      left: 0.75rem;
      padding: 0 0.5rem;
      white-space: nowrap;
    }
    .tag {
      margin-top: 0.25rem;
      line-height: 1.35;
    }
    .chip {
      --inset: 0.75rem;
    }
    .plain {
      margin-top: 0.25rem;
      font-size: 1rem;
      line-height: 1.55;
    }
    .rule,
    .engine {
      line-height: 1.35;
    }
    .engine {
      padding-left: 0.75rem;
    }
    .receipt {
      gap: 0.5rem;
      padding: 1rem;
    }
    table {
      line-height: 1.35;
    }
    th,
    td {
      width: 5rem;
    }
    tr > :first-child {
      width: 7rem;
    }
    .r-line {
      font-size: 1rem;
      line-height: 1.55;
    }
    .sample {
      margin-top: 0.75rem;
    }
  }

  @media (min-width: 1024px) {
    .replay {
      position: absolute;
      top: 0.5rem;
      right: 0.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      padding: 0 0.5rem;
      border: 0;
      background: none;
      color: var(--muted);
      font: inherit;
      cursor: pointer;
    }
    .replay[hidden] {
      display: none;
    }
    .replay:hover {
      color: var(--ink);
    }
  }

  /* Short laptops: keep the receipt above the fold. */
  @media (min-width: 1024px) and (max-height: 860px) {
    .stage {
      --env-h: 3.5rem;
      --rise: 7.1875rem;
      gap: 0.75rem;
    }
    .line {
      display: none;
    }
  }

  /* One pass on load, transform and opacity only. Every keyframe set has only a start,
     so each element ends on its own styled state. */
  .envelope {
    animation: rise 520ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 80ms) both;
  }
  .seal {
    animation: seal 300ms cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
  }
  .options > li:not(.chip) {
    animation: rise 420ms cubic-bezier(0.16, 1, 0.3, 1) calc(1200ms + var(--i) * 80ms) both;
  }
  .chip {
    animation: chip 2800ms linear both;
  }
  .stamp {
    animation: stamp 300ms cubic-bezier(0.16, 1, 0.3, 1) 2500ms both;
  }
  [data-blocked] .opt-name,
  [data-blocked] .opt-cost {
    animation: undim 300ms linear 2500ms both;
  }
  [data-blocked] .tag,
  .plain {
    animation: fade 300ms linear 2800ms both;
  }
  [data-picked] .card::after,
  li:not([data-blocked]) > .tag,
  .rule,
  .engine {
    animation: fade 400ms linear 3200ms both;
  }
  .receipt {
    animation: lift 600ms cubic-bezier(0.16, 1, 0.3, 1) 3800ms both;
  }
  .row {
    animation: fade 240ms linear calc(4400ms + var(--i) * 60ms) both;
  }
  .rewind :is(.envelope, .seal, .options > li, .stamp, .opt-name, .opt-cost, .tag, .plain, .rule, .engine, .receipt, .row),
  .rewind .card::after {
    animation: none;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
  @keyframes lift {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes undim {
    from {
      opacity: 1;
    }
  }
  @keyframes seal {
    from {
      opacity: 0;
      transform: scale(1.4);
    }
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: rotate(-4deg) scale(1.15);
    }
  }
  /* The "no" leaves Bob's sealed envelope and lands on the option; the envelope does not change. */
  @keyframes chip {
    0%,
    32% {
      opacity: 0;
      transform: translate(calc(var(--from) * var(--col) + var(--nudge)), calc(-1 * var(--rise)));
    }
    39%,
    68% {
      opacity: 1;
      transform: translate(calc(var(--from) * var(--col) + var(--nudge)), calc(-1 * var(--rise)));
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    89% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage *,
    .stage *::after {
      animation: none !important;
    }
    .chip {
      display: none;
    }
  }
  @media print {
    .stage *,
    .stage *::after {
      animation: none !important;
    }
  }
</style>
