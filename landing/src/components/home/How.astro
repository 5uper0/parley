---
// Section 2 (#how). Steps and footnote: landing-v3-copy 3.1, verbatim; the heading is the plain one.
import { howItWorks } from "../../data/film-copy";

const footnote = "The checks are plain code, not a language model.";

const steps = [
  {
    id: "how-1",
    label: "Tell.",
    body: "You tell your own agent what you like and the one thing you won't go above. That limit stays with your agent. (Developers call it a red line.)",
  },
  {
    id: "how-2",
    label: "Yes or no.",
    body: "Every agent answers yes or no to each option. An option above anyone's limit cannot win. Among the rest, Parley picks the one that helps the least-happy person most. If nothing fits everyone, it says so instead of forcing a pick.",
  },
  {
    id: "how-3",
    label: "Check.",
    body: "Everyone gets one pick and the same receipt. You check your own limit held, on your own computer.",
  },
];
---

<section id="how" class="scroll-mt-24 py-12 md:py-20" aria-labelledby="how-h">
  <div class="home-wrap">
    <h2 id="how-h" class="font-display text-3xl leading-tight tracking-tight text-ink">{howItWorks.title}</h2>
    <ol class="mt-8 grid list-none gap-8 p-0 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li id={s.id} class="scroll-mt-24 border-t border-hairline pt-4">
            <h3 class="font-display text-xl tracking-tight text-ink">
              <span class="mr-2 text-muted">{i + 1}</span>
              {s.label}
            </h3>
            <p class="mt-2 max-w-[64ch] text-base leading-relaxed text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-[64ch] text-sm leading-relaxed text-muted">{footnote}</p>
  </div>
</section>
