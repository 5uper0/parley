---
import { hotspots, roomImage, roomHint, ROOM_BREAKPOINT } from "../../data/film-hotspots";

const portMedia = `(max-width: ${ROOM_BREAKPOINT}px)`;
---

<section id="room" class="room scroll-mt-24" tabindex="-1" aria-label="The room">
  <div class="stage">
    <picture>
      <source
        media={portMedia}
        srcset={roomImage.port.src}
        width={roomImage.port.width}
        height={roomImage.port.height}
      />
      <img
        src={roomImage.land.src}
        width={roomImage.land.width}
        height={roomImage.land.height}
        alt={roomImage.alt}
        loading="lazy"
        decoding="async"
      />
    </picture>
    {
      hotspots.map((h) => (
        <a
          class="hs"
          href={`#${h.target}`}
          data-room-hotspot
          aria-label={`${h.label}, opens ${h.section}`}
          style={`--lx:${h.land.x};--ly:${h.land.y};--px:${h.port.x};--py:${h.port.y}`}
        >
          <span aria-hidden="true">{h.n}</span>
          <span class="tip" aria-hidden="true">
            {h.label}
          </span>
        </a>
      ))
    }
  </div>
  <ol class="legend" aria-hidden="true">
    {
      hotspots.map((h) => (
        <li>
          <span class="num">{h.n}</span> {h.label}
        </li>
      ))
    }
  </ol>
  <p class="hint">{roomHint}</p>
</section>

<script>
  import "../../scripts/room-hotspots.ts";
</script>

<style>
  .room {
    margin: 48px auto 0;
    width: 100%;
    max-width: 1100px;
    padding: 0 40px;
  }
  .room:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: -2px;
  }
  /* The photo is dark in both themes, so the marks keep the dark-theme tokens. */
  .stage {
    --bg: #0a0b0d;
    --ink: #f4f6f7;
    --indigo: #6675d3;
    --indigo-text: #8e9be1;
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 8px;
  }
  .stage img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 7px;
  }
  .hs {
    position: absolute;
    left: calc(var(--lx) * 1%);
    top: calc(var(--ly) * 1%);
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--indigo-text);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }
  .hs:hover,
  .hs:focus-visible {
    background: var(--bg);
    border-color: var(--ink);
    z-index: 2;
  }
  .hs:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%);
    display: none;
    white-space: nowrap;
    border-radius: 4px;
    background: var(--bg);
    padding: 4px 8px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
  }
  .hs:hover .tip,
  .hs:focus-visible .tip {
    display: block;
  }
  .legend {
    display: none;
  }
  .hint {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  /* Phones: portrait image, zoomed 1.25x on its centre, rows 55% to 83% shown.
     Numbers in ROOM-GEOMETRY.md. */
  @media (max-width: 720px) {
    .room {
      padding: 0;
    }
    .stage {
      aspect-ratio: 45 / 28;
      overflow: hidden;
      border-width: 1px 0;
      border-radius: 0;
    }
    .stage img {
      position: absolute;
      left: -12.5%;
      top: calc(-55 / 28 * 100%);
      width: 125%;
      max-width: none;
      border-radius: 0;
    }
    .hs {
      left: calc((var(--px) * 1.25 - 12.5) * 1%);
      top: calc((var(--py) - 55) / 28 * 100%);
    }
    .tip,
    .hs:hover .tip,
    .hs:focus-visible .tip {
      display: none;
    }
    .legend {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 16px;
      margin-top: 12px;
      padding: 0 24px;
      list-style: none;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.4;
    }
    .legend .num {
      color: var(--ink);
      font-weight: 600;
    }
    .hint {
      padding: 0 24px;
    }
  }
</style>
