---
import { codeSample, README_URL } from "../../../data/film-copy";

const inlineCode =
  "rounded-[5px] border border-hairline bg-surface px-[5px] py-px font-mono text-[0.92em] text-ink";
---

<section id="code" class="film-section scroll-mt-24 border-l-2 border-transparent pl-4 md:pl-6" aria-labelledby="code-h">
  <h2 id="code-h" class="font-display text-[26px] tracking-[-0.02em] text-ink">
    {codeSample.title} <span class="text-[15px] font-normal tracking-normal text-muted">{codeSample.titleNote}</span>
  </h2>
  <p class="mt-4 max-w-[64ch] text-[15px]/[25px] text-muted">
    {codeSample.intro.map((s) => (s.code ? <code class={inlineCode}>{s.text}</code> : s.text))}
  </p>
  <pre
    class="film-code mt-5 overflow-x-auto rounded-[10px] border border-hairline bg-surface px-[18px] py-4 font-mono text-[12.5px] leading-[1.9] whitespace-pre text-ink"
    tabindex="0"
    aria-label="dinner.py"><code>{codeSample.code}</code></pre>
  <p class="mt-4 text-[15px]/[25px] text-muted">
    {codeSample.readmeLabel}<a
      href={README_URL}
      target="_blank"
      rel="noopener"
      class="text-indigo-text underline underline-offset-2">{codeSample.readmeLinkText}</a
    >
  </p>
</section>

<style>
  .film-code:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 2px;
  }
</style>
