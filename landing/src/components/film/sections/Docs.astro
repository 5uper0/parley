---
import { docs, REPO_URL } from "../../../data/film-copy";
---

<section id="docs" class="film-section scroll-mt-24 border-l-2 border-transparent pl-4 md:pl-6" aria-labelledby="docs-h">
  <h2 id="docs-h" class="font-display text-[26px] tracking-[-0.02em] text-ink">{docs.title}</h2>
  <p class="mt-4 max-w-[64ch] text-[15px]/[25px] text-muted">
    {docs.body}<a href={REPO_URL} target="_blank" rel="noopener" class="text-indigo-text underline underline-offset-2"
      >{docs.linkText}</a
    >{docs.tail}
  </p>
</section>
