---
import { howItWorks } from "../../../data/film-copy";
---

<section id="how" class="film-section scroll-mt-24 border-l-2 border-transparent pl-4 md:pl-6" aria-labelledby="how-h">
  <h2 id="how-h" class="font-display text-[26px] tracking-[-0.02em] text-ink">{howItWorks.title}</h2>
  <ol class="mt-5 flex max-w-[64ch] list-decimal flex-col gap-4 pl-5 text-[15px]/[25px] text-muted marker:text-indigo-text">
    {
      howItWorks.steps.map((s) => (
        <li id={s.id} class="scroll-mt-24 pl-1">
          <strong class="font-semibold text-ink">{s.label}</strong> {s.body}
        </li>
      ))
    }
  </ol>
</section>
