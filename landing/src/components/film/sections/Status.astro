---
import { status } from "../../../data/film-copy";
---

<section id="status" class="film-section scroll-mt-24 border-l-2 border-transparent pl-4 md:pl-6" aria-labelledby="status-h">
  <h2 id="status-h" class="font-display text-[26px] tracking-[-0.02em] text-ink">{status.title}</h2>
  <p class="mt-4 max-w-[64ch] text-[15px]/[25px] text-muted">{status.lines.join(" ")}</p>
</section>
