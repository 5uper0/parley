---
import FilmPlayer from "./FilmPlayer.astro";
import { hero, DEMO_URL } from "../../data/film-copy";
---

<div class="mx-auto w-full max-w-[880px] px-6 pt-8 md:px-10 md:pt-12">
  <h1 class="font-display text-[clamp(2.1rem,5.5vw,3.3rem)] leading-[1.06] tracking-[-0.028em] text-ink">
    {hero.headline}
  </h1>
  <p class="mt-4 max-w-[58ch] text-[clamp(1rem,1.5vw,1.12rem)] leading-[1.55] text-muted md:mt-5">{hero.sub}</p>
  <p class="mt-6 md:mt-7">
    <a
      href={DEMO_URL}
      class="inline-flex min-h-12 items-center justify-center rounded-full bg-indigo px-7 py-3 text-[15px] font-semibold text-bg"
    >
      {hero.button}
    </a>
  </p>
  <div class="mt-8 md:mt-10">
    <FilmPlayer />
  </div>
</div>
