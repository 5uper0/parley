---
interface Props {
  path: string;
}

const { path } = Astro.props;
const url = `https://parleyprotocol.com${path}?utm_source=coheir-share&utm_medium=share&utm_campaign=coheir`;
const text = `Os paso esta página para que la miremos juntos antes de decidir lo de la herencia: ${url}`;
const wa = `https://wa.me/?text=${encodeURIComponent(text)}`;
const mail = `mailto:?subject=${encodeURIComponent("Para decidir juntos lo de la herencia")}&body=${encodeURIComponent(text)}`;
const btn =
  "inline-flex items-center rounded-[10px] border border-hairline px-4 py-2 text-[14px] text-ink transition-colors hover:border-current";
---

<div class="mt-8 rounded-[14px] border border-hairline bg-surface p-5" data-coheir-box>
  <p class="font-mono text-[11.5px] font-semibold tracking-[0.08em] text-subtle uppercase">
    Para el resto de herederos
  </p>
  <p class="mt-2 max-w-[52ch] text-[14.5px]/[23px] text-muted">
    Un reparto se decide entre todos. Envíe esta página a sus hermanos o a los demás
    copropietarios con un mensaje neutro, sin datos del caso.
  </p>
  <div class="mt-4 flex flex-wrap gap-3">
    <a href={wa} target="_blank" rel="noopener" data-coheir="whatsapp" class={btn}>WhatsApp</a>
    <a href={mail} data-coheir="email" class={btn}>Correo</a>
    <button type="button" data-coheir-copy={url} class={btn}>Copiar enlace</button>
  </div>
  <p class="mt-3 min-h-[1.25rem] text-[13px] break-all text-subtle" data-coheir-done role="status"></p>
</div>

<script is:inline>
  document.addEventListener("click", function (e) {
    var t = e.target && e.target.closest ? e.target : null;
    if (!t) return;
    var copy = t.closest("[data-coheir-copy]");
    var send = t.closest("[data-coheir]");
    if (copy) {
      var u = copy.getAttribute("data-coheir-copy");
      var note = document.querySelector("[data-coheir-done]");
      var say = function (m) {
        if (note) note.textContent = m;
      };
      var ok = function () {
        say("Enlace copiado.");
        if (typeof gtag === "function") gtag("event", "share_click", { method: "copy" });
      };
      var fail = function () {
        say("No se pudo copiar. Enlace: " + u);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(u).then(ok, fail);
      } else {
        fail();
      }
    } else if (send && typeof gtag === "function") {
      gtag("event", "send_to_coheir_click", { method: send.getAttribute("data-coheir") });
    }
  });
</script>
