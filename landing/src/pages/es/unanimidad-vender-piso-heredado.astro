---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const DEMO_URL = "/demo/";
const GUIDE_URL = "/es/reparto-de-herencia-entre-hermanos/";
const BOE_URL = "https://www.boe.es/buscar/act.php?id=BOE-A-2025-76";
const MAILTO = "mailto:hello@parleyprotocol.com?subject=Caso%20real%20-%20herencia";

const wrap = "mx-auto w-full max-w-[880px] px-6 md:px-10";
const sectionLabel =
  "font-mono text-[11.5px] font-semibold tracking-[0.08em] text-subtle uppercase";
const card = "rounded-[14px] border border-hairline bg-surface";
const link =
  "text-indigo-text underline decoration-hairline underline-offset-2 transition-colors hover:decoration-current";
const btnPrimary =
  "inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-indigo px-7 py-3.5 text-[15px] font-[640] text-white shadow-[inset_0_1px_0_rgba(255,255,255,.10)] transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-px hover:brightness-[1.06] active:translate-y-0 active:scale-[0.98]";
const btnGhost =
  "group inline-flex min-h-12 items-center gap-1.5 text-[15px] font-medium text-muted transition-colors hover:text-ink";

const faqs = [
  {
    q: "¿Puede un hermano obligar a los demás a vender?",
    a: "El artículo 400 del Código Civil dice que ningún copropietario está obligado a permanecer en la comunidad y que cualquiera puede pedir la división de la cosa común. Qué ocurre después depende del artículo 404 si el piso no se puede dividir: si los copropietarios lo acuerdan, se adjudica a uno que indemnice a los demás; si no hay acuerdo, se vende y se reparte el precio. Cómo se hace en la práctica y cuánto tarda es una pregunta para un abogado.",
  },
  {
    q: "¿Y si uno de los herederos vive en el piso?",
    a: "Cómo afecta a su caso que uno de los herederos viva en el piso es una pregunta para un abogado; esta página no la resuelve.",
  },
  {
    q: "¿Hay que intentar un acuerdo antes de demandar?",
    a: "La Ley Orgánica 1/2025, publicada en el BOE el 3 de enero de 2025 y en vigor desde el 3 de abril de 2025, exige en su artículo 5.1, con carácter general, intentar antes un medio adecuado de solución de controversias para poder presentar una demanda civil. Los artículos 5.2 y 5.3 enumeran excepciones. Si se aplica a su caso y cómo acreditar el intento es una pregunta para un abogado.",
  },
  {
    q: "¿Parley sirve para cumplir ese requisito?",
    a: "Esta página no afirma que un registro de Parley sirva para cumplir el artículo 5.1 de la LO 1/2025. Parley es una herramienta de código abierto que ayuda a elegir entre las opciones que ustedes escriben, y deja un registro que se puede recalcular. Nadie la ha usado todavía para una herencia real.",
  },
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "https://parleyprotocol.com/es/unanimidad-vender-piso-heredado/#article",
      headline: "¿Hace falta unanimidad entre los herederos para vender un piso heredado?",
      description:
        "Qué dicen los artículos 400 y 404 del Código Civil sobre salir de una copropiedad heredada, y qué pide la LO 1/2025 antes de demandar. Información general, no asesoramiento legal.",
      url: "https://parleyprotocol.com/es/unanimidad-vender-piso-heredado/",
      inLanguage: "es",
      datePublished: "2026-10-18",
      dateModified: "2026-10-18",
      author: { "@type": "Organization", name: "Parley", url: "https://parleyprotocol.com/" },
      publisher: { "@type": "Organization", name: "Parley", url: "https://parleyprotocol.com/" },
    },
    {
      "@type": "FAQPage",
      "@id": "https://parleyprotocol.com/es/unanimidad-vender-piso-heredado/#faq",
      inLanguage: "es",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
});
---

<Layout
  lang="es"
  title="¿Hace falta unanimidad entre los herederos para vender un piso heredado?"
  description="Tres hermanos heredan un piso: uno quiere vender y otro se niega. Qué dicen los artículos 400 y 404 del Código Civil y qué exige la LO 1/2025 antes de demandar. Información general, no asesoramiento legal."
  path="/es/unanimidad-vender-piso-heredado/"
  alternates={[
    { lang: "es", path: "/es/unanimidad-vender-piso-heredado/" },
    { lang: "uk", path: "/uk/zghoda-spadkoyemtsiv-prodazh-kvartyry/" },
    { lang: "en", path: "/spain-inherited-flat-do-all-heirs-have-to-agree/" },
  ]}
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-indigo focus:px-5 focus:py-3.5 focus:text-sm focus:font-semibold focus:text-white"
  >
    Saltar al contenido
  </a>

  <div class="flex min-h-screen flex-col">
    <div class={wrap}>
      <Header />
    </div>

    <main id="main" class="flex-1 pb-20">
      <section class={wrap}>
        <p class="mb-6 flex items-center gap-2.5 font-mono text-xs tracking-[1.4px] whitespace-nowrap text-muted uppercase">
          Guía
          <span class="h-px min-w-6 flex-1 bg-hairline" aria-hidden="true"></span>
        </p>
        <h1 class="font-display text-[clamp(2.1rem,5.5vw,3.3rem)] leading-[1.06] tracking-[-0.028em] text-ink">
          ¿Hace falta que todos los herederos estén de acuerdo para vender un piso heredado?
        </h1>
        <p class="mt-6 max-w-[58ch] text-[clamp(1rem,1.5vw,1.12rem)] leading-[1.55] text-muted">
          Tres hermanos heredan un piso. Uno quiere vender, otro se niega y el tercero está en
          medio. La pregunta es si hace falta unanimidad. Esta página resume lo que
          dicen sobre eso dos artículos del Código Civil y una ley de 2025. Es información general,
          no asesoramiento legal: para su caso concreto, consulte a un abogado.
        </p>
        <div class="mt-10 h-px w-full bg-redline/60" aria-hidden="true"></div>
      </section>

      <section class={`${wrap} mt-14`}>
        <h2 class={sectionLabel}>La respuesta corta</h2>
        <div class={`${card} mt-5 px-5 py-[18px]`}>
          <p class="max-w-[62ch] text-[15px]/[25px] text-ink">
            Según el artículo 400 del Código Civil, ningún copropietario está obligado a
            permanecer en la comunidad, y cualquiera puede pedir la división de la cosa común en
            cualquier momento. Vender de común acuerdo es otra cosa. Si no hay acuerdo, lo que
            prevé la ley para un piso es el artículo 404, abajo. Esta página trata solo de estos
            artículos; cómo se aplican a una herencia que aún no se ha repartido es una pregunta
            para un abogado.
          </p>
        </div>
      </section>

      <section class={`${wrap} mt-14`}>
        <h2 class={sectionLabel}>Qué pasa si el piso no se puede dividir</h2>
        <p class="mt-4 max-w-[62ch] text-[15px]/[25px] text-muted">
          Un piso no se corta en tres. El artículo 404 prevé ese caso: si la cosa es
          esencialmente indivisible y los copropietarios no acuerdan adjudicársela a uno de
          ellos, que indemnice a los demás, se vende y se reparte el precio.
        </p>
        <ul class="mt-4 flex max-w-[62ch] flex-col gap-2 text-[15px]/[25px] text-muted">
          <li><strong class="text-ink">Uno se queda el piso.</strong> Si lo acuerdan, se adjudica a uno que compensa a los demás.</li>
          <li><strong class="text-ink">Se vende.</strong> Si no hay acuerdo para lo anterior, se vende y el precio se reparte.</li>
        </ul>
      </section>

      <section class={`${wrap} mt-14`}>
        <h2 class={sectionLabel}>Antes de ir a juicio</h2>
        <p class="mt-4 max-w-[62ch] text-[15px]/[25px] text-muted">
          La Ley Orgánica 1/2025, en vigor desde el 3 de abril de 2025, exige en su artículo 5.1,
          con carácter general, intentar antes un medio adecuado de solución de controversias
          para poder presentar una
          demanda civil. Los artículos 5.2 y 5.3 enumeran excepciones. Qué cuenta como intento
          suficiente en su caso lo decide un abogado, no esta página. Texto en el{" "}
          <a href={BOE_URL} target="_blank" rel="noopener" class={link}>BOE</a>.
        </p>
      </section>

      <section class={`${wrap} mt-14`}>
        <h2 class={sectionLabel}>Lo que sí puede hacer antes de que llegue a eso</h2>
        <ul class="mt-4 flex max-w-[62ch] flex-col gap-2 text-[15px]/[25px] text-muted">
          <li><strong class="text-ink">Poner el precio por escrito.</strong> Una tasación independiente quita una discusión.</li>
          <li><strong class="text-ink">Escribir las opciones.</strong> Vender, que uno compre la parte de los demás, que uno siga viviendo en el piso: cada una con sus números, a la vista de todos.</li>
          <li><strong class="text-ink">Dejar constancia.</strong> Un correo con las propuestas y las respuestas deja constancia de lo hablado.</li>
        </ul>
        <p class="mt-4 max-w-[62ch] text-[15px]/[25px] text-muted">
          Si cada hermano tiene un límite que no quiere decir en voz alta, hay una forma de
          elegir sin que nadie lo revele y con un registro que puede recalcular quien tenga el archivo.
          Está explicada con un caso ilustrativo en{" "}
          <a href={GUIDE_URL} class={link}>Repartir la casa de los padres entre hermanos</a>.
        </p>
      </section>

      <section class={`${wrap} mt-14`}>
        <h2 class={sectionLabel}>Preguntas</h2>
        <div class="mt-5 flex flex-col gap-2.5">
          {
            faqs.map((f) => (
              <details class={`${card} px-5 py-4`}>
                <summary class="cursor-pointer text-[15px]/[24px] font-semibold text-ink marker:text-subtle">
                  {f.q}
                </summary>
                <p class="mt-3 max-w-[62ch] text-[14.5px]/[23px] text-muted">{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class={`${wrap} mt-14`}>
        <div class="h-px w-full bg-redline/60" aria-hidden="true"></div>
        <h2 class="mt-8 font-display text-[26px] tracking-[-0.02em] text-ink">
          Pruébelo con su propio caso.
        </h2>
        <p class="mt-3 max-w-[52ch] text-[15px]/[25px] text-muted">
          La demo reproduce ejecuciones ya calculadas del motor de Parley, sin darse de alta. Si
          tiene un reparto real entre manos, escríbanos sin nombres ni documentos y vemos si su
          caso encaja.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-6">
          <a href={DEMO_URL} data-demo="herencia" class={btnPrimary}>Probar la demo</a>
          <a href={MAILTO} data-real-case="herencia" class={btnGhost}>
            Quiero probarlo con mi caso real
            <span
              class="inline-block transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-[3px]"
              aria-hidden="true">&rarr;</span
            >
          </a>
        </div>
        <p class="mt-8 text-[13.5px] text-subtle">
          <a href="/" class={link} hreflang="en">Volver a la página principal (en inglés)</a> &middot;{" "}
          <a href="/uk/zghoda-spadkoyemtsiv-prodazh-kvartyry/" class={link} hreflang="uk" lang="uk">Українською</a>
        </p>
      </section>
    </main>

    <Footer />
  </div>

  <script is:inline>
    document.addEventListener("click", function (e) {
      var t = e.target && e.target.closest ? e.target : null;
      if (!t || typeof gtag !== "function") return;
      if (t.closest("[data-real-case]")) gtag("event", "real_case_click");
      else if (t.closest("[data-demo]")) gtag("event", "demo_click");
    });
  </script>
</Layout>
