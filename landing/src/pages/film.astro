---
import Layout from "../layouts/Layout.astro";
import FilmFooter from "../components/film/FilmFooter.astro";
import FilmHeader from "../components/film/FilmHeader.astro";
import HomeV3 from "../components/home/HomeV3.astro";
import { hero } from "../data/home-hero";
---

<Layout title={`${hero.headline} | Parley`} description={hero.sub} path="/film/" noindex>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-5 focus:py-3.5 focus:text-sm focus:font-semibold focus:text-bg"
  >
    Skip to content
  </a>

  <div class="flex min-h-screen flex-col">
    <FilmHeader />
    <HomeV3 />
    <FilmFooter />
  </div>
</Layout>
