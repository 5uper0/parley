---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import FilmHeader from "../components/film/FilmHeader.astro";
import HowItWorks from "../components/film/sections/HowItWorks.astro";
import CodeSample from "../components/film/sections/CodeSample.astro";
import Receipt from "../components/film/sections/Receipt.astro";
import Install from "../components/film/sections/Install.astro";
import Docs from "../components/film/sections/Docs.astro";
import Status from "../components/film/sections/Status.astro";
import { hero, DEMO_URL } from "../data/film-copy";
// PIECE B: import Hero from "../components/film/Hero.astro";
// PIECE C: import Room from "../components/film/Room.astro";

const wrap = "mx-auto w-full max-w-[880px] px-6 md:px-10";
---

<Layout title={`${hero.headline} | Parley`} description={hero.sub} path="/film/" noindex>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-indigo focus:px-5 focus:py-3.5 focus:text-sm focus:font-semibold focus:text-bg"
  >
    Skip to content
  </a>

  <div class="flex min-h-screen flex-col">
    <FilmHeader />

    <main id="main" class="film-main flex-1 pb-20">
      {/* PIECE B: replace this whole #hero-slot div with <Hero /> */}
      <div id="hero-slot" class={`${wrap} pt-12`}>
        <h1 class="font-display text-[clamp(2.1rem,5.5vw,3.3rem)] leading-[1.06] tracking-[-0.028em] text-ink">
          {hero.headline}
        </h1>
        <p class="mt-5 max-w-[58ch] text-[clamp(1rem,1.5vw,1.12rem)] leading-[1.55] text-muted">{hero.sub}</p>
        <p class="mt-7">
          <a
            href={DEMO_URL}
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-indigo px-7 py-3 text-[15px] font-semibold text-bg"
          >
            {hero.button}
          </a>
        </p>
      </div>

      {/* PIECE C: replace this #room-slot div with <Room /> */}
      <div id="room-slot"></div>

      <div class={`${wrap} mt-16 flex flex-col gap-14`}>
        <HowItWorks />
        <CodeSample />
        <Receipt />
        <Install />
        <Docs />
        <Status />
      </div>
    </main>

    <Footer />
  </div>

  <script is:inline>
    (function () {
      function mark() {
        var old = document.querySelectorAll(".film-section.hl");
        for (var i = 0; i < old.length; i++) old[i].classList.remove("hl");
        var el = location.hash.length > 1 && document.getElementById(location.hash.slice(1));
        var sec = el && el.closest(".film-section");
        if (sec) sec.classList.add("hl");
      }
      window.addEventListener("hashchange", mark);
      mark();
    })();
  </script>
</Layout>

<style>
  /* :target keeps the highlight working with JS off; .hl is set on hash change. */
  .film-main :global(.film-section.hl),
  .film-main :global(.film-section:target),
  .film-main :global(.film-section:has(:target)) {
    border-left-color: var(--indigo);
  }
</style>
