---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/identity/Hero.astro";
import Steps from "../components/identity/Steps.astro";
import { tapeSnippet, tapeColorClass } from "../data/tape";
import { receiptDinner } from "../data/receipt-dinner";

const DEMO_URL = "/demo/";

// Identity spec 2026-11-17 (WI-261116-134): final wording, change only with a new copy test.
const HEADLINE = "Agents that act for different people can agree without anyone handing over their limit.";
const SUB =
  "Parley is an open-source Python library. Each person's hard limits run as code: an option over anyone's limit cannot win, nobody hands over their limit sheet, and every result leaves a record anyone can check.";
const INSTALL = "pip install parley-consensus";
const SCOPE =
  `Early, version ${receiptDinner.version}, no outside users yet. Scores and accept or reject answers still show some of each person's range. It picks from a given list of options and is not built for owners who try to cheat.`;

const wrap = "mx-auto w-full max-w-[1372px] px-6 md:px-16 lg:px-24";

const btnPrimary =
  "inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-indigo px-7 py-3.5 text-[15px] font-[640] text-white shadow-[inset_0_1px_0_rgba(255,255,255,.10)] transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-px hover:brightness-[1.06] active:translate-y-0 active:scale-[0.98]";

const btnGhost =
  "group inline-flex min-h-12 items-center gap-1.5 text-[15px] font-medium text-muted transition-colors hover:text-ink";

const propBase =
  "rounded-[14px] border-t border-r border-b-[3px] border-l-[3px] border-hairline bg-surface";

const deviceBlock =
  "overflow-x-auto rounded-[10px] border border-hairline bg-bg px-[18px] py-4 font-mono text-[12.5px] leading-[1.9] text-muted";

const faqLink =
  "text-indigo-text underline decoration-hairline underline-offset-2 transition-colors hover:decoration-current";

const faqs = [
  {
    q: "What is Parley, and what problem does it solve?",
    a: "Parley is an open-source Python library for one decision among AI agents whose owners have conflicting, private interests. Each owner states red lines and preferences in private; the engine drops every option that crosses anyone's red line, picks among the rest by the max-min rule, and writes a transcript of masked verdicts that each owner can check afterwards. It is multilateral (more than two owners), uses no cryptocurrency or blockchain, and runs on your own machine.",
    href: "/fair-group-decision-private-limits/",
    guide: "A fair group decision when everyone has private limits",
  },
  {
    q: "How are red lines enforced, and what does the other side learn?",
    a: "A red line is a code predicate on an option, such as cost <= 700. An option that fails it is rejected before any score is weighed, and it is never traded against a preference. The only thing that leaves an agent is a verdict per option: acceptable or not, a score between 0 and 1, and the word ok or red-line, never which rule was behind it. The score is public, so a reader of the record can infer preference ordering and the feasible region, and across enough options the pass/fail pattern shows roughly where a red line sits, even though the reason field stays masked. The engine enforces whatever limit you typed; it cannot tell a real limit from a tactical one.",
    href: "/llm-agent-red-lines/",
    guide: "Red lines for LLM agents, enforced in code",
  },
  {
    q: "How does the group pick one option, and what happens when nothing fits?",
    a: "Only options acceptable to every participant are candidates. Among them the engine picks the option whose lowest score across participants is highest, and breaks ties by the sum of scores; this is a max-min rule, not a majority vote, so a majority cannot outvote one owner's floor. When no option clears everyone's red lines the result is a deadlock with no decision, and a deadlock forces nothing on anyone. Scores are self-reported too, and there is no resistance yet to an owner misreporting them strategically or to collusion (SECURITY.md).",
    href: "/fair-multi-agent-negotiation/",
    guide: "Fair multi-agent negotiation for rival owners",
  },
  {
    q: "What can I check afterwards, and what does the receipt not show?",
    a: "You can re-hash the transcript (SHA-256 over its canonical JSON), recompute the max-min winner from the recorded verdicts, and replay your own private sheet against the decision with verify_non_betrayal, all on your own machine and without showing the sheet to anyone. The hash is unsigned, so it catches a later edit only when someone other than the editor kept the hash; verdicts are unsigned unless the run signed them, and a signed verdict is checked against the key carried in the same record, with no trusted owner-to-key roster yet. The participants list is written by the coordinator, scores are public and leak preference ordering, and every limit is self-reported.",
    href: "/verify-ai-agent-decision/",
    guide: "Verify an AI-agent decision without trusting the coordinator",
  },
  {
    q: "How do I try it, and what does it need?",
    a: "pip install parley-consensus gives you the core with no third-party dependencies on Python 3.10 or later (tested on 3.11 to 3.14), plus the parley-mcp command, a stdio MCP server you can point Claude or Cursor at. Signed verdicts need the crypto extra, pip install \"parley-consensus[crypto]\". The examples and scripts, including the receipt verifier, are not in the PyPI wheel; clone the repository, which is Apache-2.0. It is Alpha (v0): do not run it against genuinely adversarial principals in production. The demo on this site replays pre-computed runs of the same engine.",
    href: "/mcp-multi-party-decisions/",
    guide: "Parley as an MCP server for multi-party agent decisions",
  },
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://parleyprotocol.com/#software",
      name: "Parley",
      url: "https://parleyprotocol.com/",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Any",
      description:
        "One decision among AI agents of different owners: red lines enforced in code, max-min consensus over masked verdicts, and a transcript each owner checks on their own machine. No cryptocurrency or blockchain; self-hosted, open source.",
      license: "https://github.com/5uper0/parley/blob/main/LICENSE",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      codeRepository: "https://github.com/5uper0/parley",
    },
    {
      "@type": "FAQPage",
      "@id": "https://parleyprotocol.com/#faq",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
});
---

<Layout
  title="Parley: agents that act for different people can agree"
  description={SUB}
  defaultTheme="light"
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-indigo focus:px-5 focus:py-3.5 focus:text-sm focus:font-semibold focus:text-white"
  >
    Skip to content
  </a>

  <main id="main">
    <Hero
      wrap={wrap}
      headline={HEADLINE}
      sub={SUB}
      install={INSTALL}
      scope={SCOPE}
      demoUrl={DEMO_URL}
      stepsHref="#how-it-works"
    />

    <hr class="h-px w-full border-0 bg-hairline" />

    <Steps id="how-it-works" wrap={wrap}>
      <div
        class="overflow-hidden rounded-2xl border border-hairline bg-surface"
        data-transcript-card
      >
        <div
          class="flex items-center justify-between gap-3 border-b border-hairline px-5 py-3 font-mono text-xs text-muted"
        >
          <span>parley &middot; replay 4622d0a7&hellip;</span>
          <span>transcript</span>
        </div>
        <p class="px-6 pt-3 pb-4 text-[12.5px] leading-[1.5] text-muted">
          Five people, five private lists of limits. For option A, three of
          the five answers are shown. One shared decision,{" "}
          <b class="font-semibold text-ink">checked by every owner</b>, no
          list handed over.
        </p>
        <div
          class="flex flex-col gap-3.5 border-t border-hairline p-5 font-mono text-[13px] leading-[1.5]"
        >
          <div class="flex items-center justify-between gap-2.5">
            <span class="flex-none font-medium text-ink">bob</span>
            <span class="flex-none text-xs whitespace-nowrap text-muted"
              >score 0.30</span
            >
            <span
              class="inline-flex items-center rounded-full border border-hairline bg-bg px-3.5 py-1.5 text-xs font-medium text-ink"
              >acceptable</span
            >
          </div>
          <div class="flex items-center justify-between gap-2.5">
            <span class="flex-none font-medium text-ink">cara</span>
            <span class="flex-none text-xs whitespace-nowrap text-muted"
              >score 0.70</span
            >
            <span
              class="inline-flex items-center rounded-full border border-hairline bg-bg px-3.5 py-1.5 text-xs font-medium text-ink"
              >acceptable</span
            >
          </div>
          <div class="flex items-center justify-between gap-2.5">
            <span class="flex-none font-medium text-ink">ana</span>
            <span
              class="inline-flex flex-none items-center gap-1 text-xs whitespace-nowrap text-masked"
            >
              <svg
                width="10"
                height="10"
                viewBox="0 0 10 10"
                aria-hidden="true"
                class="flex-none"
              >
                <rect
                  x="1.5"
                  y="4.5"
                  width="7"
                  height="5"
                  rx="1"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"></rect>
                <path
                  d="M3 4.5V3a2 2 0 0 1 4 0v1.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"></path>
              </svg>
              [masked]
            </span>
            <span
              class="inline-flex items-center rounded-full border border-redline/30 bg-redline/10 px-3.5 py-1.5 text-xs font-medium text-redline-text"
              >red-line</span
            >
          </div>
          <hr class="my-2.5 border-0 border-t border-dashed border-hairline" />
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="font-semibold text-indigo-text"
              >max-min picks option P</span
            >
            <span
              class="inline-flex items-center gap-1.5 text-[12.5px] font-semibold text-muted"
              >recorded sample run, red lines held 5/5</span
            >
          </div>
        </div>
        <div
          class="border-t border-hairline bg-bg px-5 py-3 font-mono text-xs leading-[1.6] text-muted"
        >
          ana's reason stays private. only the verdict "red-line" ever
          leaves her agent.
        </div>
      </div>
    </Steps>

    <hr class="h-px w-full border-0 bg-hairline" />

    <!-- Plain words: the layperson block. Keep it jargon-free; the technical sections follow. -->
    <section id="plain-words" class="py-14 lg:py-20" aria-labelledby="plain-head">
      <div class={wrap}>
        <h2
          id="plain-head"
          class="font-mono text-xs font-normal tracking-[1.4px] whitespace-nowrap text-muted uppercase"
        >
          In plain words
        </h2>
        <p
          class="mt-7 max-w-[52ch] text-[clamp(1.15rem,2vw,1.45rem)] leading-[1.42] tracking-[-0.01em] font-medium text-ink"
        >
          Parley is a way for several people's AI agents to agree on one
          option, without anyone having to hand over their private limits.
        </p>

        <div class="mt-10 max-w-[44rem]">
          <article class={`${propBase} border-b-indigo border-l-indigo p-7 md:p-8`}>
            <h3 class="text-xl font-semibold tracking-[-0.01em] text-ink">
              For example
            </h3>
            <p class="mt-3 max-w-[48ch] text-[15px] leading-[1.65] text-muted">
              Three friends are picking the dates for a weekend trip and
              splitting the cost. Each has a limit they would rather not say out
              loud. Ana cannot spend more than 200. Bob cannot leave before
              Friday evening. Cara will not share a room.
            </p>
            <p class="mt-3 max-w-[48ch] text-[15px] leading-[1.65] text-muted">
              Each one tells only their own agent. The agents go through
              the options together. Any option that crosses one friend's limit
              is out, no matter how much the other two like it.
            </p>
            <p class="mt-3 max-w-[48ch] text-[15px] leading-[1.65] text-muted">
              Among the options left, the winner is the one that leaves the
              least happy friend as well off as possible. The others see that an
              agent said no to an option, never why.
            </p>
          </article>

        </div>

        <p class="mt-8 max-w-[76ch] text-[14.5px] leading-[1.65] text-muted">
          <b class="font-semibold text-ink">Where this stands:</b> Parley is
          early, version {receiptDinner.version}, alpha. It is open source under Apache-2.0. The
          demo on this site replays runs computed in advance with the same
          engine. It does not yet protect against people who misreport their
          own scores or team up against the rest.
        </p>
      </div>
    </section>

    <hr class="h-px w-full border-0 bg-hairline" />

    <!-- Problem -->
    <section class="py-14 lg:py-20" aria-labelledby="problem-head">
      <div class={wrap}>
        <h2
          id="problem-head"
          class="font-mono text-xs font-normal tracking-[1.4px] whitespace-nowrap text-muted uppercase"
        >
          The gap nobody productised
        </h2>
        <div class="mt-7 grid gap-5 md:grid-cols-2 md:items-start md:gap-12">
          <p
            class="max-w-[44ch] text-[clamp(1.15rem,2vw,1.45rem)] leading-[1.42] tracking-[-0.01em] text-muted"
          >
            Most agent tooling solves transport (A2A, MCP), one-to-one agentic
            commerce, or cooperative debate between agents that already share
            one owner.
          </p>
          <p
            class="max-w-[44ch] text-[clamp(1.15rem,2vw,1.45rem)] leading-[1.42] tracking-[-0.01em] font-medium text-ink"
          >
            Parley solves a different gap: delegates of different, conflicting,
            private owners reaching a decision{" "}
            <span
              class="bg-[linear-gradient(to_top,var(--redline)_0_2px,transparent_2px)] pb-0.5"
              >that crosses no owner's red line</span
            >, and each owner can check it.
          </p>
        </div>
      </div>
    </section>

    <hr class="h-px w-full border-0 bg-hairline" />

    <!-- How it works -->
    <section id="properties" class="py-14 lg:py-20" aria-labelledby="how-head">
      <div class={wrap}>
        <h2
          id="how-head"
          class="mb-9 max-w-[26ch] font-display text-[clamp(1.7rem,3.4vw,2.4rem)] leading-[1.12] tracking-[-0.026em] text-ink"
        >
          Four properties, enforced in code, not left to a model's discretion.
        </h2>
        <div class="grid gap-5">
          <article
            class={`${propBase} border-b-redline border-l-redline grid gap-6 p-7 md:grid-cols-[1.05fr_.95fr] md:items-center md:p-8`}
          >
            <div>
              <h3 class="text-[1.4rem] font-semibold tracking-[-0.01em] text-ink">
                Red lines
              </h3>
              <p class="mt-2.5 max-w-[48ch] text-[14.5px] leading-[1.6] text-muted">
                Hard constraints written as code predicates. A crossed red line
                rejects an option outright. It is never negotiated away as soft
                utility.
              </p>
              <span
                class="mt-4 inline-block rounded-full border border-hairline bg-bg px-3 py-[5px] font-mono text-xs text-muted"
                >preferences.py</span
              >
            </div>
            <div class={deviceBlock} aria-label="Example: a red line rejecting an option">
              <span class="text-muted">round 1 &middot; option A proposed</span
              ><br />
              ana verdict: ok<br />
              <span class="text-redline-text">cara verdict: red-line</span
              ><br />
              <span class="text-ink">option A rejected</span>
            </div>
          </article>

          <article
            class={`${propBase} border-b-masked border-l-masked grid gap-6 p-7 md:grid-cols-[1.05fr_.95fr] md:items-center md:p-8`}
          >
            <div>
              <h3 class="text-[1.4rem] font-semibold tracking-[-0.01em] text-ink">
                Masked verdicts
              </h3>
              <p class="mt-2.5 max-w-[48ch] text-[14.5px] leading-[1.6] text-muted">
                The coordinator sees only an acceptable or red-line verdict and
                a soft score. Never the private sheet, and never which
                constraint was crossed.
              </p>
              <span
                class="mt-4 inline-block rounded-full border border-hairline bg-bg px-3 py-[5px] font-mono text-xs text-muted"
                >agent.py</span
              >
            </div>
            <div
              class={deviceBlock}
              aria-label="Example: what leaves the agent versus what stays private"
            >
              <span class="text-muted">leaves the agent:</span><br />
              <span class="text-ink">acceptable</span> &middot; score 0.71 &middot;
              reason "ok"<br />
              <span class="text-muted">stays private:</span><br />
              <span class="text-masked">the sheet, and which line was crossed</span>
            </div>
          </article>

          <div class="grid gap-5 md:grid-cols-2">
            <article class={`${propBase} border-b-indigo border-l-indigo p-7`}>
              <h3 class="text-xl font-semibold tracking-[-0.01em] text-ink">
                Max-min consensus
              </h3>
              <p class="mt-2.5 max-w-[48ch] text-[14.5px] leading-[1.6] text-muted">
                Among options feasible for everyone, lift the least-happy
                participant, tie-broken by total welfare. No feasible option
                means an honest deadlock, never a forced decision.
              </p>
              <span
                class="mt-4 inline-block rounded-full border border-hairline bg-bg px-3 py-[5px] font-mono text-xs text-muted"
                >consensus.py</span
              >
            </article>
            <article class={`${propBase} border-b-verify border-l-verify p-7`}>
              <h3 class="text-xl font-semibold tracking-[-0.01em] text-ink">
                Verifiable transcript
              </h3>
              <p class="mt-2.5 max-w-[48ch] text-[14.5px] leading-[1.6] text-muted">
                A SHA-256 hash over the canonical, masked record. Each owner
                replays their own private sheet locally to confirm no red line
                was crossed, without handing it over.
              </p>
              <span
                class="mt-4 inline-block rounded-full border border-hairline bg-bg px-3 py-[5px] font-mono text-xs text-muted"
                >transcript.py</span
              >
            </article>
          </div>
        </div>
      </div>
    </section>

    <hr class="h-px w-full border-0 bg-hairline" />

    <!-- Proof -->
    <section id="proof" class="py-14 lg:py-20" aria-labelledby="proof-head">
      <div class={wrap}>
        <div class="mb-7 flex flex-col gap-[18px]">
          <h2
            id="proof-head"
            class="max-w-[26ch] font-display text-[clamp(1.7rem,3.4vw,2.4rem)] leading-[1.12] tracking-[-0.026em] text-ink"
          >
            A real run, and you can check it.
          </h2>
          <p class="max-w-[62ch] text-base leading-[1.6] text-muted">
            The tape below is a real run. Five agents with conflicting private
            sheets, sixteen options, scored by the engine in this repository. Every
            verdict is recorded masked, hashed, and independently replayable by each
            owner against their own private sheet. The transcript hashes to
            <code class="font-mono text-[0.9em] text-ink">4622d0a7ecc2&hellip;154a0d25</code>,
            and <code class="font-mono text-[0.9em]">landing/scripts/gen-tape.py</code>
            reproduces it byte for byte.
          </p>
        </div>
        <p class="mb-3 flex items-center gap-2 font-mono text-xs text-muted">
          real transcript &middot; sha256 4622d0a7&hellip;154a0d25 &middot; hover to
          pause
        </p>
        <div
          class="group overflow-hidden rounded-xl border border-hairline bg-bg [mask-image:linear-gradient(to_right,transparent_0,black_6%,black_94%,transparent_100%)] motion-reduce:overflow-x-auto motion-reduce:[mask-image:none]"
          tabindex="0"
          role="img"
          aria-label="Scrolling excerpt of a real parley transcript: option A rejected by a red line, option P chosen by max-min consensus, red lines verified for all five owners"
        >
          <div
            class="flex w-max group-focus-within:[animation-play-state:paused] group-hover:[animation-play-state:paused] motion-safe:animate-[tick_46s_linear_infinite]"
          >
            <div class="flex flex-none items-center py-[18px]">
              {
                tapeSnippet.map((line) => (
                  <>
                    <span
                      class={`px-[18px] font-mono text-[13px] whitespace-nowrap ${tapeColorClass[line.color]}`}
                    >
                      {line.text}
                    </span>
                    <span
                      class="flex-none font-mono text-[13px] text-muted"
                      aria-hidden="true"
                    >
                      &middot;
                    </span>
                  </>
                ))
              }
            </div>
            <div class="flex flex-none items-center py-[18px]" aria-hidden="true">
              {
                tapeSnippet.map((line) => (
                  <>
                    <span
                      class={`px-[18px] font-mono text-[13px] whitespace-nowrap ${tapeColorClass[line.color]}`}
                    >
                      {line.text}
                    </span>
                    <span class="flex-none font-mono text-[13px] text-muted">
                      &middot;
                    </span>
                  </>
                ))
              }
            </div>
          </div>
        </div>
        <div
          class="mt-8 flex flex-col items-start gap-6 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between sm:gap-8"
        >
          <div class="grid grid-cols-2 gap-x-8 gap-y-5 sm:flex sm:gap-10">
            <div>
              <div
                class="font-display text-[2rem] tracking-[-0.02em] whitespace-nowrap text-ink"
              >
                5/5
              </div>
              <div class="mt-1 max-w-[18ch] text-[12.5px] text-muted">
                scripted sheets replayed in a recorded run
              </div>
            </div>
            <div>
              <div
                class="font-display text-[2rem] tracking-[-0.02em] whitespace-nowrap text-ink"
              >
                256-bit
              </div>
              <div class="mt-1 max-w-[18ch] text-[12.5px] text-muted">
                hash over the canonical record
              </div>
            </div>
            <div>
              <div
                class="font-display text-[2rem] tracking-[-0.02em] whitespace-nowrap text-indigo"
              >
                0
              </div>
              <div class="mt-1 max-w-[18ch] text-[12.5px] text-muted">
                red lines crossed in that recorded run
              </div>
            </div>
          </div>
          <a href={DEMO_URL} class={btnGhost}>
            Open the demo
          </a>
        </div>
      </div>
    </section>

    <hr class="h-px w-full border-0 bg-hairline" />

    <!-- Trust strip -->
    <section class="py-9" aria-labelledby="trust-head">
      <div class={wrap}>
        <h2 class="sr-only" id="trust-head">Positioning</h2>
        <p class="max-w-[76ch] text-sm leading-[1.65] text-muted">
          <b class="font-semibold text-ink">Multilateral</b> (more than two owners),
          <b class="font-semibold text-ink">no cryptocurrency</b>,
          <b class="font-semibold text-ink">self-hosted</b>,
          <b class="font-semibold text-ink">auditable</b>. Not single-owner
          orchestration like AutoGen or CrewAI. Not bilateral on-chain commerce
          like Fetch.ai or Olas.
        </p>
        <p class="mt-4 max-w-[76ch] text-sm leading-[1.65] text-muted">
          Guides:{" "}
          <a href="/mcp-multi-party-decisions/" class="text-indigo-text underline decoration-hairline underline-offset-2 transition-colors hover:decoration-current">run Parley as an MCP tool in Claude or Cursor</a>,{" "}
          <a href="/fair-multi-agent-negotiation/" class="text-indigo-text underline decoration-hairline underline-offset-2 transition-colors hover:decoration-current">how the negotiation stays fair</a>,{" "}
          <a href="/llm-agent-red-lines/" class="text-indigo-text underline decoration-hairline underline-offset-2 transition-colors hover:decoration-current">what a red line is, exactly</a>,{" "}
          <a href="/verify-ai-agent-decision/" class="text-indigo-text underline decoration-hairline underline-offset-2 transition-colors hover:decoration-current">how to verify a decision receipt afterwards</a>,{" "}
          <a href="/fair-group-decision-private-limits/" class="text-indigo-text underline decoration-hairline underline-offset-2 transition-colors hover:decoration-current">a fair group decision when everyone has private limits</a>.
        </p>
      </div>
    </section>

    <hr class="h-px w-full border-0 bg-hairline" />

    <!-- Questions -->
    <section id="questions" class="py-14 lg:py-20" aria-labelledby="questions-head">
      <div class={wrap}>
        <h2
          id="questions-head"
          class="font-mono text-xs font-normal tracking-[1.4px] whitespace-nowrap text-muted uppercase"
        >
          Questions
        </h2>
        <div class="mt-7 flex max-w-[76ch] flex-col gap-2.5">
          {
            faqs.map((f) => (
              <details class="rounded-[14px] border border-hairline bg-surface px-5 py-4">
                <summary class="cursor-pointer text-[15px] leading-[1.6] font-semibold text-ink marker:text-subtle">
                  {f.q}
                </summary>
                <p class="mt-3 max-w-[62ch] text-[14.5px] leading-[1.6] text-muted">{f.a}</p>
                <p class="mt-3 text-[13px] text-subtle">
                  Guide:{" "}
                  <a href={f.href} class={faqLink}>
                    {f.guide}
                  </a>
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <hr class="border-0 border-t-2 border-redline opacity-90" />

    <!-- Closing CTA -->
    <section class="py-18 lg:pt-24 lg:pb-28" aria-labelledby="closing-head">
      <div class={wrap}>
        <h2
          id="closing-head"
          class="font-display text-[clamp(2.1rem,5.2vw,3.6rem)] leading-[1.08] tracking-[-0.028em]"
        >
          <span class="block text-ink">Put your next decision</span>
          <span class="block text-indigo">on the tape.</span>
        </h2>
        <div class="mt-8 flex flex-wrap items-center gap-6">
          <a href={DEMO_URL} class={btnPrimary}>Open the demo</a>
          <a href="#how-it-works" class={btnGhost}>
            Read the 3 steps
          </a>
        </div>
      </div>
    </section>

    <hr class="h-px w-full border-0 bg-hairline" />
  </main>

  <div class="mx-auto w-full max-w-[1372px]">
    <Footer />
  </div>
</Layout>

<style is:global>
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }
</style>
